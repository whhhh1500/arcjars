RPC_URL=https://rpc.mainnet.arc.io
FACTORY=0x...            # from deployments/arc-mainnet.json
FROM_BLOCK=0             # factory deploy block (speeds up discovery)
KEEPER_PK=0x...          # any funded throwaway key; sweep() and collectFees() are permissionless
INTERVAL_SEC=60
MIN_SWEEP_USDC=0.01
MIN_FEES_USDC=5
